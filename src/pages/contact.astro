---
import WorkflowLayout from '../layouts/WorkflowLayout.astro';
---

<WorkflowLayout title="Contact" currentPage={4}>
  <section class="min-h-screen flex items-center justify-center pt-20 pb-8 px-6 page-enter">
    <div class="max-w-4xl w-full">
      <!-- Header -->
      <div class="mb-16 text-center">
        <p class="font-mono text-sm text-accent tracking-widest uppercase mb-6">
          Node 04 — Contact
        </p>
        <h1 class="text-5xl md:text-7xl text-fg mb-6 leading-tight">
          Travaillons ensemble
        </h1>
        <p class="text-lg text-fg-dim max-w-2xl mx-auto">
          Prêt à automatiser vos processus ? Discutons de votre projet.
        </p>
      </div>

      <!-- Formulaire -->
      <div class="bg-surface border border-border rounded-lg p-8 md:p-12 page-enter-delay-1">
        <form class="space-y-6">
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block font-mono text-xs text-fg-dim uppercase tracking-wider mb-2">
                Nom
              </label>
              <input
                type="text"
                class="w-full px-4 py-3 rounded-lg bg-bg border border-border text-fg focus:border-accent focus:outline-none transition-colors"
                placeholder="Votre nom"
              />
            </div>
            <div>
              <label class="block font-mono text-xs text-fg-dim uppercase tracking-wider mb-2">
                Email
              </label>
              <input
                type="email"
                class="w-full px-4 py-3 rounded-lg bg-bg border border-border text-fg focus:border-accent focus:outline-none transition-colors"
                placeholder="votre@email.com"
              />
            </div>
          </div>

          <div>
            <label class="block font-mono text-xs text-fg-dim uppercase tracking-wider mb-2">
              Entreprise
            </label>
            <input
              type="text"
              class="w-full px-4 py-3 rounded-lg bg-bg border border-border text-fg focus:border-accent focus:outline-none transition-colors"
              placeholder="Nom de votre entreprise"
            />
          </div>

          <div>
            <label class="block font-mono text-xs text-fg-dim uppercase tracking-wider mb-2">
              Type de projet
            </label>
            <select class="w-full px-4 py-3 rounded-lg bg-bg border border-border text-fg focus:border-accent focus:outline-none transition-colors">
              <option value="">Sélectionnez une option</option>
              <option value="workflow">Workflow d'automatisation</option>
              <option value="agent-ia">Agent IA</option>
              <option value="integration">Intégration de systèmes</option>
              <option value="custom">Projet sur mesure</option>
              <option value="other">Autre</option>
            </select>
          </div>

          <div>
            <label class="block font-mono text-xs text-fg-dim uppercase tracking-wider mb-2">
              Description du projet
            </label>
            <textarea
              rows="6"
              class="w-full px-4 py-3 rounded-lg bg-bg border border-border text-fg focus:border-accent focus:outline-none transition-colors resize-none"
              placeholder="Décrivez votre projet, vos besoins, vos contraintes..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full px-8 py-4 rounded-lg bg-accent text-bg font-semibold hover:bg-accent/90 transition-colors"
          >
            Envoyer la demande
          </button>
        </form>
      </div>

      <!-- Infos de contact -->
      <div class="mt-12 grid md:grid-cols-3 gap-6">
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-surface border border-border flex items-center justify-center">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <p class="font-mono text-xs text-fg-dim mb-1">Email</p>
          <p class="text-sm text-fg">contact@achillerobbe.dev</p>
        </div>

        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-surface border border-border flex items-center justify-center">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <p class="font-mono text-xs text-fg-dim mb-1">Localisation</p>
          <p class="text-sm text-fg">France — Remote</p>
        </div>

        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-surface border border-border flex items-center justify-center">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <p class="font-mono text-xs text-fg-dim mb-1">Disponibilité</p>
          <p class="text-sm text-fg">Dès maintenant</p>
        </div>
      </div>

      <!-- Navigation -->
      <div class="mt-16 flex justify-center">
        <a
          href="/projects/"
          data-nav="prev"
          class="inline-flex items-center gap-3 px-6 py-3 rounded-full border border-border text-fg hover:border-accent hover:text-accent transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
          </svg>
          <span>Projets</span>
        </a>
      </div>
    </div>
  </section>
</WorkflowLayout>
