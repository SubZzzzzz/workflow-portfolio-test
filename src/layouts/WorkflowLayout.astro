---
import '../styles/global.css';
import WorkflowMinimap from '../components/WorkflowMinimap.astro';
import WorkflowConnections from '../components/WorkflowConnections.astro';

interface Props {
  title: string;
  currentPage: number;
}

const { title, currentPage } = Astro.props;
const totalPages = 4;

const pagePaths: Record<number, string> = {
  1: '/',
  2: '/services/',
  3: '/projects/',
  4: '/contact/',
};

const currentPath = pagePaths[currentPage] || '/';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio Workflow — Achille Robbe" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <WorkflowConnections currentPage={currentPath} />
    
    <WorkflowMinimap
      currentPage={currentPage}
      totalPages={totalPages}
    />
    
    <main class="relative z-10">
      <slot />
    </main>
    
    <script type="module" src="../scripts/transition-engine.ts"></script>
  </body>
</html>
