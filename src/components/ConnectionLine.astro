---
interface Props {
  animated?: boolean;
}

const { animated = true } = Astro.props;
---

<svg class="connection-line absolute w-full h-full pointer-events-none" viewBox="0 0 100 100" preserveAspectRatio="none">
  <defs>
    <linearGradient id="lineGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#00D4FF;stop-opacity:0" />
      <stop offset="50%" style="stop-color:#00D4FF;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#00D4FF;stop-opacity:0" />
    </linearGradient>
  </defs>
  <line
    x1="0"
    y1="50"
    x2="100"
    y2="50"
    stroke="url(#lineGradient)"
    stroke-width="0.5"
    class:animate={animated}
  />
</svg>

<style>
  .connection-line {
    opacity: 0.3;
  }

  .animate line {
    animation: flow 3s ease-in-out infinite;
  }

  @keyframes flow {
    0% {
      stroke-dasharray: 0, 1000;
      stroke-dashoffset: 0;
    }
    50% {
      stroke-dasharray: 100, 1000;
      stroke-dashoffset: 200;
    }
    100% {
      stroke-dasharray: 0, 1000;
      stroke-dashoffset: 1000;
    }
  }
</style>
