---
interface Props {
  currentNode: number;
  totalPages: number;
}

const { currentNode, totalPages } = Astro.props;
const isFirst = currentNode === 1;
const isLast = currentNode === totalPages;

// Layout zigzag (mêmes positions que la minimap)
const positions = [
  { x: 10, y: 10 },      // Start
  { x: 10, y: 70 },      // Services
  { x: 110, y: 70 },     // Projects
  { x: 110, y: 130 },    // Contact
];

type Direction = 'top' | 'bottom' | 'left' | 'right';

function getDirection(fromIdx: number, toIdx: number): Direction {
  const from = positions[fromIdx];
  const to = positions[toIdx];
  if (from.x === to.x) {
    return from.y < to.y ? 'bottom' : 'top';
  }
  return from.x < to.x ? 'right' : 'left';
}

const currentIndex = currentNode - 1;
const prevDirection = currentIndex > 0 ? getDirection(currentIndex, currentIndex - 1) : null;
const nextDirection = currentIndex < positions.length - 1 ? getDirection(currentIndex, currentIndex + 1) : null;

const baseButton = 'nav-arrow pointer-events-auto flex items-center justify-center w-12 h-12 rounded-full border transition-all duration-200 hover:scale-110 z-50';
const prevColors = 'border-green-500/50 bg-green-500/10 hover:bg-green-500/20';
const nextColors = 'border-orange-500/50 bg-orange-500/10 hover:bg-orange-500/20';
---

<!-- Flèche précédent (verte — node validé) -->
{prevDirection && !isFirst && (
  <button
    class:list={[
      baseButton,
      prevColors,
      prevDirection === 'top' && 'fixed top-20 left-1/2 -translate-x-1/2',
      prevDirection === 'bottom' && 'fixed bottom-6 left-1/2 -translate-x-1/2',
      prevDirection === 'left' && 'fixed left-4 top-1/2 -translate-y-1/2',
      prevDirection === 'right' && 'fixed right-4 top-1/2 -translate-y-1/2',
    ]}
    data-action="prev"
    aria-label="Node précédent"
  >
    <svg class:list={[
      'w-6 h-6 text-green-500',
      prevDirection === 'top' && 'rotate-180',
      prevDirection === 'bottom' && 'rotate-0',
      prevDirection === 'left' && 'rotate-90',
      prevDirection === 'right' && '-rotate-90',
    ]} fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12l7 7 7-7" />
    </svg>
  </button>
)}

<!-- Flèche suivant (orange — node en cours) -->
{nextDirection && !isLast && (
  <button
    class:list={[
      baseButton,
      nextColors,
      nextDirection === 'top' && 'fixed top-20 left-1/2 -translate-x-1/2',
      nextDirection === 'bottom' && 'fixed bottom-6 left-1/2 -translate-x-1/2',
      nextDirection === 'left' && 'fixed left-4 top-1/2 -translate-y-1/2',
      nextDirection === 'right' && 'fixed right-4 top-1/2 -translate-y-1/2',
    ]}
    data-action="next"
    aria-label="Node suivant"
  >
    <svg class:list={[
      'w-6 h-6 text-orange-500',
      nextDirection === 'top' && 'rotate-180',
      nextDirection === 'bottom' && 'rotate-0',
      nextDirection === 'left' && 'rotate-90',
      nextDirection === 'right' && '-rotate-90',
    ]} fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12l7 7 7-7" />
    </svg>
  </button>
)}
