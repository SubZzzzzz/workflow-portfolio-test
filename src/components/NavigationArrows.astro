---
interface Props {
  currentNode: number;
  totalPages: number;
}

const { currentNode, totalPages } = Astro.props;
const isFirst = currentNode === 1;
const isLast = currentNode === totalPages;
---

<div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-6 pointer-events-none">
  <!-- Flèche gauche (node précédent) -->
  <button
    class="nav-arrow pointer-events-auto group flex items-center justify-center w-10 h-10 rounded-full border transition-all duration-200 disabled:opacity-30 disabled:cursor-not-allowed"
    disabled={isFirst}
    data-action="prev"
    aria-label="Node précédent"
    style:border-color={isFirst ? '#1E3050' : '#22C55E'}
    style:background-color={isFirst ? 'rgba(30, 48, 80, 0.3)' : 'rgba(34, 197, 94, 0.1)'}
  >
    <svg
      class="w-5 h-5 transition-colors"
      fill="none"
      stroke={isFirst ? '#1E3050' : '#22C55E'}
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <!-- Indicateur de page -->
  <div class="font-mono text-xs text-fg-dim pointer-events-none">
    {currentNode} / {totalPages}
  </div>

  <!-- Flèche droite (node suivant) -->
  <button
    class="nav-arrow pointer-events-auto group flex items-center justify-center w-10 h-10 rounded-full border border-accent bg-accent/10 transition-all duration-200 hover:bg-accent/20 disabled:opacity-30 disabled:cursor-not-allowed"
    disabled={isLast}
    data-action="next"
    aria-label="Node suivant"
  >
    <svg
      class="w-5 h-5 text-accent"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>
</div>
