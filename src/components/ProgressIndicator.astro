---
interface Props {
  currentNode: number;
  totalPages: number;
  pageName: string;
}

const { currentNode, totalPages, pageName } = Astro.props;
---

<div class="fixed top-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 px-5 py-2.5 rounded-full border border-border bg-surface/90 backdrop-blur-sm">
  <span class="font-mono text-xs text-fg-dim uppercase tracking-wider">
    Node {currentNode}/{totalPages}
  </span>
  <span class="w-1 h-1 rounded-full bg-border"></span>
  <span class="font-serif-display text-sm text-fg italic">
    {pageName}
  </span>
</div>
