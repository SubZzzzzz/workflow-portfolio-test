---
interface Props {
  label: string;
  title: string;
  description: string;
  status?: 'idle' | 'active' | 'completed';
}

const { label, title, description, status = 'idle' } = Astro.props;

const statusColors = {
  idle: 'border-border bg-surface',
  active: 'border-accent bg-surface shadow-lg shadow-accent/20',
  completed: 'border-accent-secondary bg-surface',
};

const dotColors = {
  idle: 'bg-muted',
  active: 'bg-accent',
  completed: 'bg-accent-secondary',
};
---

<div class={`node group relative border-2 rounded-lg p-6 transition-all duration-300 hover:scale-105 ${statusColors[status]}`}>
  {/* Ports d'input/output */}
  <div class="absolute -left-2 top-1/2 -translate-y-1/2 w-4 h-4 rounded-full border-2 border-border bg-bg"></div>
  <div class="absolute -right-2 top-1/2 -translate-y-1/2 w-4 h-4 rounded-full border-2 border-border bg-bg"></div>

  {/* Label */}
  <div class="font-mono text-xs text-muted uppercase tracking-wider mb-3">
    {label}
  </div>

  {/* Titre */}
  <h3 class="text-xl font-bold mb-2 text-fg group-hover:text-accent transition-colors">
    {title}
  </h3>

  {/* Description */}
  <p class="text-sm text-muted leading-relaxed">
    {description}
  </p>

  {/* Indicateur de statut */}
  <div class="absolute top-4 right-4 flex items-center gap-2">
    <span class={`w-2 h-2 rounded-full ${dotColors[status]}`}></span>
    {status === 'active' && (
      <span class="font-mono text-xs text-accent uppercase">Active</span>
    )}
  </div>

  {/* Glow effect pour active */}
  {status === 'active' && (
    <div class="absolute inset-0 rounded-lg bg-accent/5 blur-xl -z-10"></div>
  )}
</div>

<style>
  .node {
    position: relative;
  }

  .node:hover::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 0.5rem;
    background: linear-gradient(135deg, rgba(0, 212, 255, 0.1), rgba(0, 255, 136, 0.1));
    z-index: -1;
    animation: pulse-border 2s ease-in-out infinite;
  }

  @keyframes pulse-border {
    0%, 100% {
      opacity: 0.5;
    }
    50% {
      opacity: 1;
    }
  }
</style>
