---
import GraphNode from './GraphNode.astro';
import ConnectionLine from './ConnectionLine.astro';
---

<section class="relative min-h-screen py-32 px-6">
  <div class="max-w-7xl mx-auto">
    <h2 class="font-mono text-sm text-accent tracking-widest uppercase mb-16 text-center">
      Système de Connexions
    </h2>

    <div class="relative">
      {/* Nœud central */}
      <div class="flex justify-center mb-32">
        <GraphNode
          label="START"
          title="Automatisation"
          description="Connecter les systèmes, optimiser les processus"
          status="active"
        />
      </div>

      {/* Première ligne de connexions */}
      <div class="grid md:grid-cols-3 gap-16 md:gap-8">
        <GraphNode
          label="01"
          title="Workflows n8n"
          description="Création de workflows complexes et automatisés"
          status="active"
        />
        <GraphNode
          label="02"
          title="Agents IA"
          description="Bots intelligents sur WhatsApp et Discord"
          status="idle"
        />
        <GraphNode
          label="03"
          title="Intégrations"
          description="Connexion entre vos outils existants"
          status="idle"
        />
      </div>

      {/* Deuxième ligne */}
      <div class="grid md:grid-cols-2 gap-16 mt-32">
        <GraphNode
          label="04"
          title="Sur Mesure"
          description="Solutions personnalisées pour votre business"
          status="idle"
        />
        <GraphNode
          label="05"
          title="Support"
          description="Maintenance et évolution continue"
          status="idle"
        />
      </div>
    </div>
  </div>
</section>
