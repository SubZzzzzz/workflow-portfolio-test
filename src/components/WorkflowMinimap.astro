---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

const pages = [
  { id: 1, label: 'Start', href: '/' },
  { id: 2, label: 'Services', href: '/services/' },
  { id: 3, label: 'Projects', href: '/projects/' },
  { id: 4, label: 'Contact', href: '/contact/' },
];

// Dimensions SVG — tout aligné horizontalement
const svgWidth = 580;
const svgHeight = 48;
const nodeWidth = 96;
const nodeHeight = 32;
const portRadius = 4;
const gapX = 40; // espacement horizontal entre nodes
const startX = 20;
const nodeY = 8; // tous les nodes à la même hauteur

function getNodeX(index: number) {
  return startX + index * (nodeWidth + gapX);
}
---

<nav class="fixed top-3 left-1/2 -translate-x-1/2 z-50" aria-label="Navigation workflow">
  <div class="px-5 py-3 rounded-lg border border-border bg-surface/95 backdrop-blur-sm">
    <svg
      viewBox={`0 0 ${svgWidth} ${svgHeight}`}
      class="w-[300px] md:w-[480px] h-auto"
      aria-hidden="true"
    >
      <defs>
        <filter id="activeGlow" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feFlood flood-color="#E8B86A" flood-opacity="0.4" result="color" />
          <feComposite in="color" in2="blur" operator="in" result="glowColor" />
          <feMerge>
            <feMergeNode in="glowColor" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      {pages.map((page, index) => {
        const x = getNodeX(index);
        const centerY = nodeY + nodeHeight / 2;
        const isActive = page.id === currentPage;
        const isPast = page.id < currentPage;

        // Node suivant (pour la connexion)
        const nextIndex = index + 1;
        const hasNext = nextIndex < pages.length;
        const nextX = hasNext ? getNodeX(nextIndex) : null;

        return (
          <g>
            {/* Ligne droite horizontale vers le node suivant */}
            {hasNext && nextX !== null && (
              <line
                x1={x + nodeWidth + portRadius}
                y1={centerY}
                x2={nextX - portRadius}
                y2={centerY}
                stroke={isPast ? '#E8B86A' : '#1E3050'}
                stroke-width={isPast ? '1.5' : '1'}
                opacity={isPast ? '0.7' : '0.4'}
              />
            )}

            {/* Node cliquable */}
            <a href={page.href} class="cursor-pointer" aria-label={`Aller à ${page.label}`}>
              {/* Rectangle du node */}
              <rect
                x={x}
                y={nodeY}
                width={nodeWidth}
                height={nodeHeight}
                rx="4"
                fill={isActive ? 'rgba(232, 184, 106, 0.15)' : 'rgba(21, 34, 56, 0.6)'}
                stroke={isActive ? '#E8B86A' : '#1E3050'}
                stroke-width={isActive ? '2' : '1'}
                filter={isActive ? 'url(#activeGlow)' : undefined}
              />

              {/* Label */}
              <text
                x={x + nodeWidth / 2}
                y={centerY + 1}
                text-anchor="middle"
                dominant-baseline="middle"
                fill={isActive ? '#E8B86A' : '#8899B4'}
                font-size="10"
                font-family="JetBrains Mono, monospace"
                font-weight={isActive ? '500' : '400'}
                class="pointer-events-none select-none"
              >
                {page.label}
              </text>

              {/* Port input (gauche) */}
              <circle
                cx={x + 2}
                cy={centerY}
                r={portRadius}
                fill={isPast || isActive ? '#E8B86A' : '#0A1628'}
                stroke={isPast || isActive ? '#E8B86A' : '#2A4060'}
                stroke-width="1.5"
              />

              {/* Port output (droite) */}
              <circle
                cx={x + nodeWidth - 2}
                cy={centerY}
                r={portRadius}
                fill={isPast || isActive ? '#E8B86A' : '#0A1628'}
                stroke={isPast || isActive ? '#E8B86A' : '#2A4060'}
                stroke-width="1.5"
              />

              {/* Zone de clic élargie */}
              <rect
                x={x - 4}
                y={nodeY - 4}
                width={nodeWidth + 8}
                height={nodeHeight + 8}
                fill="transparent"
              />
            </a>
          </g>
        );
      })}
    </svg>
  </div>
</nav>
