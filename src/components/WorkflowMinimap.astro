---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

const pages = [
  { id: 1, label: 'Start', href: '/' },
  { id: 2, label: 'Services', href: '/services/' },
  { id: 3, label: 'Projects', href: '/projects/' },
  { id: 4, label: 'Contact', href: '/contact/' },
];

// Couleurs du workflow
const COLOR_ACTIVE = '#F97316';   // orange — node en cours d'exécution
const COLOR_DONE = '#22C55E';     // vert — node validé/complété
const COLOR_IDLE = '#1E3050';     // bleu sombre — node à venir
const COLOR_PORT_IDLE = '#0A1628';

// Layout zigzag
const nodeWidth = 80;
const nodeHeight = 28;
const portRadius = 3;
const svgWidth = 200;
const svgHeight = 180;

const positions = [
  { x: 10, y: 10 },      // Start
  { x: 10, y: 70 },      // Services (en dessous)
  { x: 110, y: 70 },     // Projects (à droite)
  { x: 110, y: 130 },    // Contact (en dessous)
];

type Direction = 'top' | 'bottom' | 'left' | 'right';

function getConnectionDirection(fromIdx: number, toIdx: number): { out: Direction; in: Direction } {
  const from = positions[fromIdx];
  const to = positions[toIdx];
  const fromCx = from.x + nodeWidth / 2;
  const toCx = to.x + nodeWidth / 2;

  if (fromCx === toCx) {
    return from.y < to.y
      ? { out: 'bottom', in: 'top' }
      : { out: 'top', in: 'bottom' };
  }
  return from.x < to.x
    ? { out: 'right', in: 'left' }
    : { out: 'left', in: 'right' };
}

function getPortPosition(pos: { x: number; y: number }, dir: Direction) {
  const offset = 1;
  switch (dir) {
    case 'top': return { cx: pos.x + nodeWidth / 2, cy: pos.y - offset };
    case 'bottom': return { cx: pos.x + nodeWidth / 2, cy: pos.y + nodeHeight + offset };
    case 'left': return { cx: pos.x - offset, cy: pos.y + nodeHeight / 2 };
    case 'right': return { cx: pos.x + nodeWidth + offset, cy: pos.y + nodeHeight / 2 };
  }
}

function getNodeColor(isActive: boolean, isPast: boolean) {
  if (isActive) return COLOR_ACTIVE;
  if (isPast) return COLOR_DONE;
  return COLOR_IDLE;
}

function getNodeFill(isActive: boolean, isPast: boolean) {
  if (isActive) return 'rgba(249, 115, 22, 0.12)';
  if (isPast) return 'rgba(34, 197, 94, 0.08)';
  return 'rgba(21, 34, 56, 0.6)';
}

function getTextColor(isActive: boolean, isPast: boolean) {
  if (isActive) return COLOR_ACTIVE;
  if (isPast) return COLOR_DONE;
  return '#8899B4';
}
---

<nav class="fixed top-4 left-4 z-50" aria-label="Navigation workflow">
  <div class="px-4 py-4 rounded-lg border border-border bg-surface/95 backdrop-blur-sm">
    <svg
      viewBox={`0 0 ${svgWidth} ${svgHeight}`}
      class="w-[180px] h-auto"
      aria-hidden="true"
    >
      {pages.map((page, index) => {
        const pos = positions[index];
        const isActive = page.id === currentPage;
        const isPast = page.id < currentPage;

        const strokeColor = getNodeColor(isActive, isPast);
        const fillColor = getNodeFill(isActive, isPast);
        const textColor = getTextColor(isActive, isPast);

        // Connexion sortante
        const nextIndex = index + 1;
        const hasNext = nextIndex < positions.length;
        const outConn = hasNext ? getConnectionDirection(index, nextIndex) : null;
        const outPort = outConn ? getPortPosition(pos, outConn.out) : null;

        // Connexion entrante
        const prevIndex = index - 1;
        const hasPrev = prevIndex >= 0;
        const inConn = hasPrev ? getConnectionDirection(prevIndex, index) : null;
        const inPort = inConn ? getPortPosition(pos, inConn.in) : null;

        // Port d'entrée du node suivant (pour la ligne)
        const nextPos = hasNext ? positions[nextIndex] : null;
        const nextInPort = (outConn && nextPos) ? getPortPosition(nextPos, outConn.in) : null;

        // Couleur de la ligne : verte si le node source est validé, orange si en cours
        const lineColor = isPast ? COLOR_DONE : isActive ? COLOR_ACTIVE : COLOR_IDLE;
        const lineWidth = (isPast || isActive) ? '2' : '1.5';
        const lineOpacity = (isPast || isActive) ? '0.8' : '0.4';

        return (
          <g>
            {/* Ligne de connexion */}
            {hasNext && outPort && nextInPort && (
              <line
                x1={outPort.cx}
                y1={outPort.cy}
                x2={nextInPort.cx}
                y2={nextInPort.cy}
                stroke={lineColor}
                stroke-width={lineWidth}
                opacity={lineOpacity}
              />
            )}

            {/* Node cliquable */}
            <a href={page.href} class="cursor-pointer" aria-label={`Aller à ${page.label}`}>
              <rect
                x={pos.x}
                y={pos.y}
                width={nodeWidth}
                height={nodeHeight}
                rx="4"
                fill={fillColor}
                stroke={strokeColor}
                stroke-width={isActive ? '2' : '1'}
              />

              <text
                x={pos.x + nodeWidth / 2}
                y={pos.y + nodeHeight / 2 + 1}
                text-anchor="middle"
                dominant-baseline="middle"
                fill={textColor}
                font-size="9"
                font-family="JetBrains Mono, monospace"
                font-weight={isActive ? '600' : '400'}
                class="pointer-events-none select-none"
              >
                {page.label}
              </text>

              {/* Port d'entrée */}
              {hasPrev && inPort && (
                <circle
                  cx={inPort.cx}
                  cy={inPort.cy}
                  r={portRadius}
                  fill={isPast ? COLOR_DONE : isActive ? COLOR_ACTIVE : COLOR_PORT_IDLE}
                  stroke={isPast ? COLOR_DONE : isActive ? COLOR_ACTIVE : '#2A4060'}
                  stroke-width="1.5"
                />
              )}

              {/* Port de sortie */}
              {hasNext && outPort && (
                <circle
                  cx={outPort.cx}
                  cy={outPort.cy}
                  r={portRadius}
                  fill={isPast ? COLOR_DONE : isActive ? COLOR_ACTIVE : COLOR_PORT_IDLE}
                  stroke={isPast ? COLOR_DONE : isActive ? COLOR_ACTIVE : '#2A4060'}
                  stroke-width="1.5"
                />
              )}

              <rect
                x={pos.x - 4}
                y={pos.y - 4}
                width={nodeWidth + 8}
                height={nodeHeight + 8}
                fill="transparent"
              />
            </a>
          </g>
        );
      })}
    </svg>
  </div>
</nav>
