---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

const pages = [
  { id: 1, label: 'Start', href: '/' },
  { id: 2, label: 'Services', href: '/services/' },
  { id: 3, label: 'Projects', href: '/projects/' },
  { id: 4, label: 'Contact', href: '/contact/' },
];

// Dimensions pour layout vertical en zigzag
const nodeWidth = 80;
const nodeHeight = 28;
const portRadius = 3;
const svgWidth = 200;
const svgHeight = 180;

// Positions en zigzag : Start → Services → Projects → Contact
const positions = [
  { x: 10, y: 10 },      // Start (en haut à gauche)
  { x: 10, y: 70 },      // Services (en dessous de Start)
  { x: 110, y: 70 },     // Projects (à droite de Services)
  { x: 110, y: 130 },    // Contact (en dessous de Projects)
];

function getNodeCenter(nodeIndex: number) {
  const pos = positions[nodeIndex];
  return {
    x: pos.x + nodeWidth / 2,
    y: pos.y + nodeHeight / 2,
  };
}
---

<nav class="fixed top-4 left-4 z-50" aria-label="Navigation workflow">
  <div class="px-4 py-4 rounded-lg border border-border bg-surface/95 backdrop-blur-sm">
    <svg
      viewBox={`0 0 ${svgWidth} ${svgHeight}`}
      class="w-[180px] h-auto"
      aria-hidden="true"
    >
      <defs>
        <filter id="activeGlow" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feFlood flood-color="#E8B86A" flood-opacity="0.4" result="color" />
          <feComposite in="color" in2="blur" operator="in" result="glowColor" />
          <feMerge>
            <feMergeNode in="glowColor" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      {pages.map((page, index) => {
        const pos = positions[index];
        const isActive = page.id === currentPage;
        const isPast = page.id < currentPage;

        // Calculer la connexion vers le node suivant (lignes droites verticales/horizontales)
        const nextIndex = index + 1;
        const hasNext = nextIndex < positions.length;
        let connectionPath = '';
        
        if (hasNext) {
          const currentCenter = getNodeCenter(index);
          const nextCenter = getNodeCenter(nextIndex);
          
          // Ligne verticale ou horizontale selon la position
          if (currentCenter.x === nextCenter.x) {
            // Connexion verticale (Start → Services ou Projects → Contact)
            connectionPath = `M ${currentCenter.x} ${currentCenter.y + nodeHeight / 2} L ${nextCenter.x} ${nextCenter.y - nodeHeight / 2}`;
          } else {
            // Connexion horizontale (Services → Projects)
            connectionPath = `M ${currentCenter.x + nodeWidth / 2} ${currentCenter.y} L ${nextCenter.x - nodeWidth / 2} ${nextCenter.y}`;
          }
        }

        return (
          <g>
            {/* Ligne de connexion */}
            {hasNext && (
              <path
                d={connectionPath}
                fill="none"
                stroke={isPast ? '#E8B86A' : '#1E3050'}
                stroke-width={isPast ? '2' : '1.5'}
                opacity={isPast ? '0.8' : '0.5'}
              />
            )}

            {/* Node cliquable */}
            <a href={page.href} class="cursor-pointer" aria-label={`Aller à ${page.label}`}>
              {/* Rectangle du node */}
              <rect
                x={pos.x}
                y={pos.y}
                width={nodeWidth}
                height={nodeHeight}
                rx="4"
                fill={isActive ? 'rgba(232, 184, 106, 0.15)' : 'rgba(21, 34, 56, 0.6)'}
                stroke={isActive ? '#E8B86A' : '#1E3050'}
                stroke-width={isActive ? '2' : '1'}
                filter={isActive ? 'url(#activeGlow)' : undefined}
              />

              {/* Label */}
              <text
                x={pos.x + nodeWidth / 2}
                y={pos.y + nodeHeight / 2 + 1}
                text-anchor="middle"
                dominant-baseline="middle"
                fill={isActive ? '#E8B86A' : '#8899B4'}
                font-size="9"
                font-family="JetBrains Mono, monospace"
                font-weight={isActive ? '500' : '400'}
                class="pointer-events-none select-none"
              >
                {page.label}
              </text>

              {/* Port input (gauche) */}
              <circle
                cx={pos.x + 2}
                cy={pos.y + nodeHeight / 2}
                r={portRadius}
                fill={isPast || isActive ? '#E8B86A' : '#0A1628'}
                stroke={isPast || isActive ? '#E8B86A' : '#2A4060'}
                stroke-width="1.5"
              />

              {/* Port output (droite) */}
              <circle
                cx={pos.x + nodeWidth - 2}
                cy={pos.y + nodeHeight / 2}
                r={portRadius}
                fill={isPast || isActive ? '#E8B86A' : '#0A1628'}
                stroke={isPast || isActive ? '#E8B86A' : '#2A4060'}
                stroke-width="1.5"
              />

              {/* Zone de clic élargie */}
              <rect
                x={pos.x - 4}
                y={pos.y - 4}
                width={nodeWidth + 8}
                height={nodeHeight + 8}
                fill="transparent"
              />
            </a>
          </g>
        );
      })}
    </svg>
  </div>
</nav>
