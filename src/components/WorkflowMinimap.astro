---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

const pages = [
  { id: 1, label: 'Start', href: '/' },
  { id: 2, label: 'Services', href: '/services/' },
  { id: 3, label: 'Projects', href: '/projects/' },
  { id: 4, label: 'Contact', href: '/contact/' },
];

// Dimensions SVG
const svgWidth = 480;
const svgHeight = 52;
const nodeWidth = 64;
const nodeHeight = 24;
const nodeY = 6;
const portRadius = 3;
const gapBetweenNodes = 12;

// Calcul des positions X
const totalNodesWidth = pages.length * nodeWidth + (pages.length - 1) * gapBetweenNodes;
const startX = (svgWidth - totalNodesWidth) / 2;

function getNodeX(index: number) {
  return startX + index * (nodeWidth + gapBetweenNodes);
}
---

<nav class="fixed top-5 left-1/2 -translate-x-1/2 z-50" aria-label="Navigation workflow">
  <div class="px-5 py-3 rounded-lg border border-border bg-surface/90 backdrop-blur-sm">
    <svg
      viewBox={`0 0 ${svgWidth} ${svgHeight}`}
      class="w-[280px] md:w-[420px] h-auto"
      aria-hidden="true"
    >
      <defs>
        {/* Glow filter pour le node actif */}
        <filter id="nodeGlow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>

      {pages.map((page, index) => {
        const x = getNodeX(index);
        const isActive = page.id === currentPage;
        const isPast = page.id < currentPage;

        // Connexion courbe vers le node suivant
        const nextX = index < pages.length - 1 ? getNodeX(index + 1) : null;

        return (
          <g>
            {/* Connexion courbe (dessinée avant le node pour passer derrière) */}
            {nextX && (
              <g>
                {/* Port out du node courant */}
                <line
                  x1={x + nodeWidth}
                  y1={nodeY + nodeHeight / 2}
                  x2={x + nodeWidth + 6}
                  y2={nodeY + nodeHeight / 2}
                  stroke={isPast ? '#E8B86A' : '#1E3050'}
                  stroke-width="1"
                  opacity="0.6"
                />
                {/* Courbe de Bézier S */}
                <path
                  d={`M ${x + nodeWidth + 6} ${nodeY + nodeHeight / 2 - 4}
                      C ${x + nodeWidth + 20} ${nodeY - 2},
                        ${nextX - 20} ${nodeY + nodeHeight + 2},
                        ${nextX - 6} ${nodeY + nodeHeight / 2 + 4}`}
                  fill="none"
                  stroke={isPast ? '#E8B86A' : '#1E3050'}
                  stroke-width="1.2"
                  opacity="0.5"
                />
                {/* Port in du node suivant */}
                <line
                  x1={nextX - 6}
                  y1={nodeY + nodeHeight / 2}
                  x2={nextX}
                  y2={nodeY + nodeHeight / 2}
                  stroke={isPast ? '#E8B86A' : '#1E3050'}
                  stroke-width="1"
                  opacity="0.6"
                />
              </g>
            )}

            {/* Node rectangle */}
            <a href={page.href} class="cursor-pointer" aria-label={`Aller à ${page.label}`}>
              <rect
                x={x}
                y={nodeY}
                width={nodeWidth}
                height={nodeHeight}
                rx="4"
                fill={isActive ? 'rgba(232, 184, 106, 0.08)' : 'transparent'}
                stroke={isActive ? '#E8B86A' : '#1E3050'}
                stroke-width={isActive ? '1.5' : '1'}
                filter={isActive ? 'url(#nodeGlow)' : undefined}
                class="transition-all duration-200 hover:stroke-[#E8B86A]/60"
              />

              {/* Label dans le node */}
              <text
                x={x + nodeWidth / 2}
                y={nodeY + nodeHeight / 2 + 1}
                text-anchor="middle"
                dominant-baseline="middle"
                fill={isActive ? '#E8B86A' : '#8899B4'}
                font-size="8"
                font-family="JetBrains Mono, monospace"
                font-weight={isActive ? '500' : '400'}
                class="pointer-events-none select-none"
              >
                {page.label}
              </text>

              {/* Port input (gauche) */}
              <circle
                cx={x + 1}
                cy={nodeY + nodeHeight / 2}
                r={portRadius}
                fill={isPast || isActive ? '#E8B86A' : '#0A1628'}
                stroke={isPast || isActive ? '#E8B86A' : '#1E3050'}
                stroke-width="1"
              />

              {/* Port output (droite) */}
              <circle
                cx={x + nodeWidth - 1}
                cy={nodeY + nodeHeight / 2}
                r={portRadius}
                fill={isPast || isActive ? '#E8B86A' : '#0A1628'}
                stroke={isPast || isActive ? '#E8B86A' : '#1E3050'}
                stroke-width="1"
              />

              {/* Zone de clic invisible plus large */}
              <rect
                x={x - 4}
                y={nodeY - 4}
                width={nodeWidth + 8}
                height={nodeHeight + 8}
                fill="transparent"
              />
            </a>
          </g>
        );
      })}
    </svg>
  </div>
</nav>
