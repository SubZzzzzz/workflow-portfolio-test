---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

const pages = [
  { id: 1, label: 'Start', href: '/' },
  { id: 2, label: 'Services', href: '/services/' },
  { id: 3, label: 'Projects', href: '/projects/' },
  { id: 4, label: 'Contact', href: '/contact/' },
];

// Layout zigzag
const nodeWidth = 80;
const nodeHeight = 28;
const portRadius = 3;
const svgWidth = 200;
const svgHeight = 180;

const positions = [
  { x: 10, y: 10 },      // Start
  { x: 10, y: 70 },      // Services (en dessous)
  { x: 110, y: 70 },     // Projects (à droite)
  { x: 110, y: 130 },    // Contact (en dessous)
];

// Pour chaque node, calculer les directions d'entrée et de sortie
type Direction = 'top' | 'bottom' | 'left' | 'right';

function getConnectionDirection(fromIdx: number, toIdx: number): { out: Direction; in: Direction } {
  const from = positions[fromIdx];
  const to = positions[toIdx];
  const fromCx = from.x + nodeWidth / 2;
  const fromCy = from.y + nodeHeight / 2;
  const toCx = to.x + nodeWidth / 2;
  const toCy = to.y + nodeHeight / 2;

  if (fromCx === toCx) {
    // Connexion verticale
    return from.y < to.y
      ? { out: 'bottom', in: 'top' }
      : { out: 'top', in: 'bottom' };
  }
  // Connexion horizontale
  return from.x < to.x
    ? { out: 'right', in: 'left' }
    : { out: 'left', in: 'right' };
}

function getPortPosition(pos: { x: number; y: number }, dir: Direction) {
  switch (dir) {
    case 'top': return { cx: pos.x + nodeWidth / 2, cy: pos.y + 2 };
    case 'bottom': return { cx: pos.x + nodeWidth / 2, cy: pos.y + nodeHeight - 2 };
    case 'left': return { cx: pos.x + 2, cy: pos.y + nodeHeight / 2 };
    case 'right': return { cx: pos.x + nodeWidth - 2, cy: pos.y + nodeHeight / 2 };
  }
}
---

<nav class="fixed top-4 left-4 z-50" aria-label="Navigation workflow">
  <div class="px-4 py-4 rounded-lg border border-border bg-surface/95 backdrop-blur-sm">
    <svg
      viewBox={`0 0 ${svgWidth} ${svgHeight}`}
      class="w-[180px] h-auto"
      aria-hidden="true"
    >
      <defs>
        <filter id="activeGlow" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feFlood flood-color="#E8B86A" flood-opacity="0.4" result="color" />
          <feComposite in="color" in2="blur" operator="in" result="glowColor" />
          <feMerge>
            <feMergeNode in="glowColor" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      {pages.map((page, index) => {
        const pos = positions[index];
        const isActive = page.id === currentPage;
        const isPast = page.id < currentPage;

        // Connexion sortante
        const nextIndex = index + 1;
        const hasNext = nextIndex < positions.length;
        const conn = hasNext ? getConnectionDirection(index, nextIndex) : null;
        const outPort = conn ? getPortPosition(pos, conn.out) : null;
        const nextPos = hasNext ? positions[nextIndex] : null;
        const inPort = (conn && nextPos) ? getPortPosition(nextPos, conn.in) : null;

        return (
          <g>
            {/* Ligne de connexion (port de sortie → port d'entrée du suivant) */}
            {hasNext && outPort && inPort && (
              <line
                x1={outPort.cx}
                y1={outPort.cy}
                x2={inPort.cx}
                y2={inPort.cy}
                stroke={isPast ? '#E8B86A' : '#1E3050'}
                stroke-width={isPast ? '2' : '1.5'}
                opacity={isPast ? '0.8' : '0.5'}
              />
            )}

            {/* Node cliquable */}
            <a href={page.href} class="cursor-pointer" aria-label={`Aller à ${page.label}`}>
              <rect
                x={pos.x}
                y={pos.y}
                width={nodeWidth}
                height={nodeHeight}
                rx="4"
                fill={isActive ? 'rgba(232, 184, 106, 0.15)' : 'rgba(21, 34, 56, 0.6)'}
                stroke={isActive ? '#E8B86A' : '#1E3050'}
                stroke-width={isActive ? '2' : '1'}
                filter={isActive ? 'url(#activeGlow)' : undefined}
              />

              <text
                x={pos.x + nodeWidth / 2}
                y={pos.y + nodeHeight / 2 + 1}
                text-anchor="middle"
                dominant-baseline="middle"
                fill={isActive ? '#E8B86A' : '#8899B4'}
                font-size="9"
                font-family="JetBrains Mono, monospace"
                font-weight={isActive ? '500' : '400'}
                class="pointer-events-none select-none"
              >
                {page.label}
              </text>

              {/* Port d'entrée (si ce n'est pas le premier node) */}
              {index > 0 && conn && (
                <circle
                  cx={getPortPosition(pos, conn.in).cx}
                  cy={getPortPosition(pos, conn.in).cy}
                  r={portRadius}
                  fill={isPast || isActive ? '#E8B86A' : '#0A1628'}
                  stroke={isPast || isActive ? '#E8B86A' : '#2A4060'}
                  stroke-width="1.5"
                />
              )}

              {/* Port de sortie (si ce n'est pas le dernier node) */}
              {hasNext && outPort && (
                <circle
                  cx={outPort.cx}
                  cy={outPort.cy}
                  r={portRadius}
                  fill={isPast || isActive ? '#E8B86A' : '#0A1628'}
                  stroke={isPast || isActive ? '#E8B86A' : '#2A4060'}
                  stroke-width="1.5"
                />
              )}

              {/* Zone de clic élargie */}
              <rect
                x={pos.x - 4}
                y={pos.y - 4}
                width={nodeWidth + 8}
                height={nodeHeight + 8}
                fill="transparent"
              />
            </a>
          </g>
        );
      })}
    </svg>
  </div>
</nav>
